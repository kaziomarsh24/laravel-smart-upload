{
    "name": "thekaziomar/laravel-smart-upload",
    "description": "A developer-first, zero-database file and chunk upload toolkit for Laravel with built-in image optimization, strict security, and database rollback safeguards.",
    "keywords": [
        "laravel",
        "upload",
        "file-upload",
        "image-processing",
        "webp",
        "chunk-upload",
        "security",
        "thekaziomar"
    ],
    "homepage": "https://github.com/kaziomarsh24/laravel-smart-upload",
    "license": "MIT",
    "authors": [
        {
            "name": "Kazi Omar Faruk",
            "email": "softeng.kaziomar@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "ext-fileinfo": "*",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "intervention/image": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "KaziOmar\\SmartUpload\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "KaziOmar\\SmartUpload\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KaziOmar\\SmartUpload\\SmartUploadServiceProvider"
            ],
            "aliases": {
                "Upload": "KaziOmar\\SmartUpload\\Facades\\Upload"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
